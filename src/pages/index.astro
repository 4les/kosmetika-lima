---
import fotoStanislava from '../assets/stanislava.webp';
import fotoNastroje from '../assets/nastroje.webp';
import fotoSalon from '../assets/salon.jpg';

import Zaklad from '../layouts/Zaklad.astro';
import KartaOsetreni from '../components/KartaOsetreni.astro';
import data from '../data/osetreni.json';
import kontakt from '../data/kontakt.json';
import { odkaz } from '../lib/odkaz';

// Na úvodní stránce ukazuji jen tři ošetření jako ochutnávku.
// Změna výběru = přepsat tato id (musí existovat v osetreni.json).
const vyber = ['cistici-osetreni', 'madero-plet-komplet', 'balicek-pristrojovy'];
const ukazka = vyber
  .map((id) => data.osetreni.find((o) => o.id === id))
  .filter(Boolean);
---

<Zaklad
  titulek="Kosmetika a péče o pleť"
  popis="Kosmetické a přístrojové ošetření pleti, madero terapie, obočí a depilace v Hlučíně. Individuální péče bez spěchu, objednávky na telefonu."
>
  <!-- ÚVOD -->
  <section class="hero">
    <div class="wrap hero__mrizka">
      <div>
        <p class="eyebrow">Kosmetický salon · {kontakt.adresa.mesto}</p>
        <h1>Péče o pleť,<br />kterou <em>skládám</em><br />podle Vaší pleti.</h1>
        <p class="lede hero__text">
          Kosmetické a přístrojové ošetření, madero terapie, obočí a depilace.
          Jedna klientka, jeden termín, žádný spěch.
        </p>
        <div class="tlacitka">
          <a class="btn btn--primary" href={`tel:${kontakt.telefonLink}`}>
            Objednat se <span class="btn__num">{kontakt.telefon.replace('+420 ', '')}</span>
          </a>
          <a class="btn btn--ghost" href={odkaz('/osetreni/')}>Vybrat ošetření</a>
        </div>

        <dl class="fakta">
          <div><dt>1 : 1</dt><dd>bez čekárny</dd></div>
          <div><dt>{kontakt.adresa.ulice}</dt><dd>{kontakt.adresa.mesto}</dd></div>
          <div><dt>Dle objednávek</dt><dd>termín po telefonu</dd></div>
        </dl>
      </div>

      <figure class="portret">
        <img
          src={fotoStanislava.src}
          alt={`${kontakt.provozovatel}, kosmetička`}
          width={fotoStanislava.width} height={fotoStanislava.height}
        />
        <figcaption>
          <b>{kontakt.provozovatel}</b>
          <span>ošetření vedu osobně</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- CO ŘEŠÍTE -->
  <section class="band band--shell">
    <div class="wrap">
      <p class="eyebrow">Kde začít</p>
      <h2>Řekněte mi, co řešíte.</h2>
      <p class="lede" style="margin-top:18px">
        Nemusíte znát názvy přístrojů. Vyberte, co Vás trápí, a uvidíte jen ta
        ošetření, která to řeší — včetně délky a ceny.
      </p>

      <div class="rozcestnik">
        {data.kategorie.map((k) => (
          <a href={odkaz(`/osetreni/?resim=${k.id}`)}>{k.nazev}</a>
        ))}
      </div>

      <div class="ukazka">
        {ukazka.map((o) => <KartaOsetreni osetreni={o} />)}
      </div>

      <div class="tlacitka">
        <a class="btn btn--ghost" href={odkaz('/osetreni/')}>Všechna ošetření a ceny</a>
      </div>
    </div>
  </section>

  <!-- MADERO -->
  <section class="band band--pine">
    <div class="wrap dvojice dvojice--nastroje">
      <div>
        <p class="eyebrow">Madero terapie</p>
        <h2>Dřevo místo přístroje.</h2>
        <p class="lede" style="margin-top:18px">
          Masážní technika se soustavou tvarovaných dřevěných nástrojů. Na obličeji
          rozhýbe lymfu a zpevní ovál, na těle rozbíjí uzlíky celulitidy a uvolní
          přetížené svaly.
        </p>
        <ul class="prinosy">
          <li>Podpora lymfy a odvod toxinů</li>
          <li>Redukce otoků a kruhů pod očima</li>
          <li>Zpevnění a tvarování postavy</li>
          <li>Úleva od svalového napětí</li>
        </ul>
        <div class="tlacitka">
          <a class="btn btn--ghost" href={odkaz('/madero-terapie/')}>Jak to probíhá</a>
        </div>
      </div>
      <img class="foto-nastroje" src={fotoNastroje.src}
           alt="Sada dřevěných nástrojů pro madero terapii"
           width={fotoNastroje.width} height={fotoNastroje.height} />
    </div>
  </section>

  <!-- O MNĚ -->
  <section class="band">
    <div class="wrap dvojice dvojice--obraceno">
      <img class="foto" src={fotoSalon.src} alt="Prostředí salonu"
           width={fotoSalon.width} height={fotoSalon.height} />
      <div>
        <p class="eyebrow">O mně</p>
        <h2>Salon vedu sama.<br />To je celý koncept.</h2>
        <p class="lede" style="margin-top:20px">
          Ke každé klientce přistupuji individuálně — ošetření skládám podle toho,
          co pleť zrovna potřebuje, ne podle ceníkové položky. Ráda poradím i s
          domácí péčí.
        </p>
        <div class="znacky">
          {kontakt.znacky.map((z) => <span>{z}</span>)}
        </div>
        <div class="tlacitka">
          <a class="btn btn--ghost" href={odkaz('/o-mne/')}>Víc o mně</a>
        </div>
      </div>
    </div>
  </section>

  <!-- VÝZVA -->
  <section class="band band--pine band--tight">
    <div class="wrap vyzva">
      <div>
        <h2>Domluvíme termín?</h2>
        <p class="lede" style="margin-top:14px">
          {kontakt.oteviraciPoznamka}
        </p>
      </div>
      <a class="btn btn--primary" href={`tel:${kontakt.telefonLink}`}>
        Zavolat <span class="btn__num">{kontakt.telefon}</span>
      </a>
    </div>
  </section>
</Zaklad>

<style>
  /* Fotka nástrojů má tmavé pozadí, proto smí i do barevného pásu.
     Je na šířku, takže dostává širší sloupec — jinak by se sada
     musela ořezávat a půlka nástrojů by zmizela. */
  .foto-nastroje {
    width: 100%;
    max-width: 620px;
    height: auto;
    justify-self: end;
    border-radius: var(--radius);
  }
  .hero { padding: clamp(44px, 7vw, 84px) 0 clamp(52px, 7vw, 88px); }
  .hero__mrizka {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(28px, 4.5vw, 60px);
    align-items: center;
  }
  .hero h1 em { font-style: italic; color: var(--petrol); }
  .hero__text { margin-top: 26px; max-width: 44ch; }

  .fakta {
    margin: 36px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .fakta div { display: flex; flex-direction: column; gap: 4px; }
  .fakta dt { font-family: var(--mono); font-size: .95rem; font-weight: 500; }
  .fakta dd { margin: 0; font-size: .78rem; color: var(--muted); letter-spacing: .04em; }

  .portret {
    position: relative;
    margin: 0;
    /* Strop šířky. Bez něj fotka na širokém monitoru naroste
       a vytlačí celý úvod pod okraj obrazovky. */
    width: min(100%, 400px);
    justify-self: end;
  }
  .portret img {
    width: 100%;
    height: auto;          /* celá fotka, nikdy oříznutá */
    border-radius: var(--radius);
    background: var(--linen-deep);
  }
  .portret figcaption {
    position: absolute;
    left: -12px;
    right: 32px;
    bottom: 22px;
    background: var(--shell);
    padding: 14px 20px;
    border-radius: 12px;
    box-shadow: 0 12px 34px var(--stin-vyrazny);
    border-left: 3px solid var(--honey);
  }
  .portret figcaption b { display: block; font-family: var(--display); font-size: 1.1rem; font-weight: 500; }
  .portret figcaption span { font-size: .78rem; color: var(--muted); }

  .rozcestnik { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .rozcestnik a {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 10px 20px;
    font-size: .9rem;
    text-decoration: none;
    transition: background .18s ease, color .18s ease, border-color .18s ease;
  }
  .rozcestnik a:hover { background: var(--pine); color: var(--linen); border-color: var(--pine); }

  .ukazka {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 34px;
  }

  .dvojice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 72px);
    align-items: center;
  }
  /* Musí být až za .dvojice — stejná specificita, rozhoduje pořadí. */
  .dvojice--nastroje { grid-template-columns: 1fr 1.25fr; }
  .foto {
    width: min(100%, 440px);
    height: auto;
    border-radius: var(--radius);
    background: var(--linen-deep);
  }

  .prinosy { list-style: none; padding: 0; margin: 26px 0 0; }
  .prinosy li {
    padding: 13px 0;
    border-bottom: 1px solid var(--rule-dark);
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-size: .95rem;
  }
  .prinosy li::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--honey);
    flex-shrink: 0;
  }

  .znacky { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .znacky span {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 8px 16px;
    color: var(--muted);
  }

  .vyzva {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero__mrizka, .dvojice, .dvojice--nastroje { grid-template-columns: 1fr; }
    .foto-nastroje { max-width: 100%; justify-self: start; }
    .portret { order: -1; width: min(100%, 300px); justify-self: center; }

    .dvojice--obraceno .foto { order: 2; }
    .foto { width: min(100%, 340px); }
  }
</style>
