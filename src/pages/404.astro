---
import Zaklad from '../layouts/Zaklad.astro';
import kontakt from '../data/kontakt.json';
import { odkaz } from '../lib/odkaz';
---

<Zaklad titulek="Stránka nenalezena" popis="Tato stránka neexistuje.">
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Chyba 404</p>
      <h1>Tuto stránku se mi nepodařilo najít</h1>
      <p class="lede" style="margin-top:20px">
        Stránka se pravděpodobně přesunula nebo v adrese došlo k překlepu.
        Zkuste přehled ošetření, nejspíš hledáte právě ten.
      </p>
      <div class="tlacitka">
        <a class="btn btn--primary" href={odkaz('/osetreni/')}>Ošetření a ceník</a>
        <a class="btn btn--ghost" href={odkaz('/')}>Na úvod</a>
      </div>
    </div>
  </section>
</Zaklad>
