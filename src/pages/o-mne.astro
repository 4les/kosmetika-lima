---
import fotoPortret from '../assets/stanislava-portret.webp';

import Zaklad from '../layouts/Zaklad.astro';
import kontakt from '../data/kontakt.json';
import { odkaz } from '../lib/odkaz';
---

<Zaklad
  titulek="O mně"
  popis="Stanislava Stalzerová, kosmetička v Hlučíně. Salon vedu sama, takže mám na každou klientku dostatek času. Pracuji s kosmetikou Merllin a Palatine."
>
  <section class="band">
    <div class="wrap dvojice">
      <img class="portret" src={fotoPortret.src} alt={kontakt.provozovatel}
           width={fotoPortret.width} height={fotoPortret.height} />
      <div>
        <p class="eyebrow">O mně</p>
        <h1>Čas jen pro Vás.</h1>
        <p class="lede" style="margin-top:22px">
          Jmenuji se {kontakt.provozovatel} a mým přáním je, abyste se cítila
          dobře a spokojeně ve své vlastní kůži.
        </p>
        <p>
          Salon vedu sama, a proto mám na každou klientku dostatek času a
          prostoru. Ošetření probíhá v klidu a bez zbytečného spěchu. Chci,
          abyste odcházela nejen s pocitem dobře ošetřené pleti, ale také
          s příjemným pocitem, že jste si na chvíli udělala čas sama pro sebe.
        </p>
        <p>
          Věnuji se kosmetickému ošetření pleti, kosmetickým masážím,
          maderoterapii pleti i těla, mikrojehličkování, galvanizaci, úpravě
          a laminaci obočí a řas a depilaci. Každé ošetření přizpůsobuji tomu,
          co Vaše pleť právě potřebuje.
        </p>
        <p>
          Ráda Vám poradím i s domácí péčí a s produkty, které Vašemu typu pleti
          vyhovují, pokud o doporučení budete mít zájem.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--shell band--tight">
    <div class="wrap">
      <p class="eyebrow">Čím pracuji</p>
      <h2>Kosmetika a přístroje</h2>
      <p class="lede" style="margin-top:18px">
        Pracuji s kvalitními přírodními produkty značek Merllin a Palatine, které
        jsou k pleti šetrné. Ve spojení s laserem Sparidonn se jejich účinek ještě
        znásobuje, protože pleť dokáže aktivní látky lépe přijmout.
      </p>
      <div class="znacky">
        {kontakt.znacky.map((z) => <span>{z}</span>)}
      </div>
    </div>
  </section>

  <section class="band band--pine band--tight">
    <div class="wrap vyzva">
      <div>
        <h2>Přijďte se podívat</h2>
        <p class="lede" style="margin-top:14px">
          Ať už hledáte profesionální ošetření pleti, nebo si chcete jen na chvíli
          odpočinout, ráda Vás v salonu přivítám.
        </p>
      </div>
      <a class="btn btn--primary" href={`tel:${kontakt.telefonLink}`}>
        Zavolat <span class="btn__num">{kontakt.telefon}</span>
      </a>
    </div>
  </section>
</Zaklad>

<style>
  .dvojice {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(30px, 5vw, 68px);
    align-items: start;
  }
  .portret {
    width: min(100%, 380px);
    height: auto;
    border-radius: var(--radius);
    background: var(--linen-deep);
  }
  .znacky { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .znacky span {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 8px 16px;
    color: var(--muted);
  }
  .vyzva {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    justify-content: space-between;
    align-items: center;
  }
  @media (max-width: 900px) {
    .dvojice { grid-template-columns: 1fr; }
    .portret { width: min(100%, 300px); }
  }
</style>
