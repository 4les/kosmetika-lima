---
import fotoNastroje from '../assets/nastroje.webp';
import fotoMadero from '../assets/madero.webp';

import Zaklad from '../layouts/Zaklad.astro';
import KartaOsetreni from '../components/KartaOsetreni.astro';
import data from '../data/osetreni.json';
import kontakt from '../data/kontakt.json';
import { odkaz } from '../lib/odkaz';

const madero = data.osetreni.filter((o) => o.skupina === 'Maderoterapie');

const oblicej = [
  ['Prokrvení pleti', 'Masáž podporuje krevní oběh, takže se do pokožky snáze dostává kyslík i živiny.'],
  ['Podpora lymfatického systému', 'Rozproudí lymfu a pomáhá tělu odvádět to, co v něm zbytečně zůstává.'],
  ['Podpora regenerace', 'Stimuluje tvorbu kolagenu a elastinu, které pleť potřebuje pro svou pružnost.'],
  ['Pevnost a kontury', 'Pomáhá zlepšit napětí pleti, nejvíce je to znát na oválu obličeje.'],
  ['Otoky a kruhy pod očima', 'Zmírňuje otoky a projasňuje oblast kolem očí.'],
  ['Čistší pleť', 'Napomáhá odstranění odumřelých buněk a pleť po ošetření lépe dýchá.'],
];

const telo = [
  ['Struktura pokožky', 'Pomáhá rozrušit tukové uzlíky a postupně zlepšuje strukturu pokožky.'],
  ['Podpora lymfatického systému', 'Podporuje odvod přebytečné vody a pocit lehkosti v nohách.'],
  ['Prokrvení a regenerace', 'Lepší prokrvení znamená i rychlejší regeneraci tkání.'],
  ['Uvolnění svalového napětí', 'Uleví přetíženým a ztuhlým svalům, ať už ze sedavé práce, nebo ze sportu.'],
  ['Zpevnění a tvarování', 'Podporuje pružnost kůže a pomáhá tvarovat problematické partie.'],
  ['Celkové uvolnění', 'Po proceduře se většina klientek cítí odpočatě a plná energie.'],
];
---

<Zaklad
  titulek="Maderoterapie"
  popis="Maderoterapie obličeje a těla v Hlučíně. Masáž tvarovanými dřevěnými nástroji, která podporuje lymfatický systém, prokrvení a celkové uvolnění."
>
  <section class="band band--pine">
    <div class="wrap dvojice dvojice--nastroje">
      <div>
        <p class="eyebrow">Maderoterapie</p>
        <h1>Masáž dřevěnými nástroji</h1>
        <p class="lede" style="margin-top:22px">
          Maderoterapie využívá speciálně tvarované dřevěné nástroje a masážní
          techniky, které podporují lymfatický systém, prokrvení a celkové
          uvolnění.
        </p>
        <p class="lede" style="margin-top:14px">
          Každý z nástrojů má svůj tvar i své využití. Podle toho, na jakou
          oblast se při ošetření zaměřujeme, volím jejich kombinaci i intenzitu
          masáže.
        </p>
        <div class="tlacitka">
          <a class="btn btn--primary" href={`tel:${kontakt.telefonLink}`}>
            Objednat se <span class="btn__num">{kontakt.telefon.replace('+420 ', '')}</span>
          </a>
        </div>
      </div>
      <img class="foto-nastroje" src={fotoNastroje.src}
           alt="Sada dřevěných nástrojů pro maderoterapii"
           width={fotoNastroje.width} height={fotoNastroje.height} />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Obličej, krk a dekolt</p>
      <h2>Maderoterapie obličeje</h2>
      <p class="lede" style="margin-top:18px">
        Jemnější varianta určená pro oblast obličeje, krku a dekoltu. Zaměřuje se
        především na kontury a na podporu přirozené regenerace pleti.
      </p>
      <div class="dvojice dvojice--foto">
        <ul class="ucinky ucinky--uzke">
          {oblicej.map(([nazev, text]) => (
            <li class="rv"><b>{nazev}</b><span>{text}</span></li>
          ))}
        </ul>
        <img class="foto" src={fotoMadero.src}
             alt="Stanislava Stalzerová s dřevěnými nástroji pro maderoterapii"
             width={fotoMadero.width} height={fotoMadero.height} />
      </div>
    </div>
  </section>

  <section class="band band--shell">
    <div class="wrap">
      <p class="eyebrow">Celé tělo</p>
      <h2>Maderoterapie těla</h2>
      <p class="lede" style="margin-top:18px">
        Intenzivnější varianta, která pomáhá uvolnit napětí a zaměřit se na
        problematické partie. Nejlépe se osvědčuje v sérii, kdy na sebe
        jednotlivé procedury navazují.
      </p>
      <ul class="ucinky">
        {telo.map(([nazev, text]) => (
          <li class="rv"><b>{nazev}</b><span>{text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Ceny a délka</p>
      <h2>Varianty a ceny</h2>
      <div class="karty">
        {madero.map((o) => <KartaOsetreni osetreni={o} />)}
      </div>
      <p class="poznamka">
        Série vychází výhodněji než jednotlivé návštěvy a hlavně přináší
        znatelně lepší výsledky. U maderoterapie těla proto doporučuji
        absolvovat alespoň pět procedur.
      </p>
    </div>
  </section>
</Zaklad>

<style>
  /* Fotka nástrojů má tmavé pozadí, proto smí i do barevného pásu.
     Je na šířku, takže dostává širší sloupec — jinak by se sada
     musela ořezávat a půlka nástrojů by zmizela. */
  .foto-nastroje {
    width: 100%;
    max-width: 620px;
    height: auto;
    justify-self: end;
    border-radius: var(--radius);
  }
  .dvojice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 72px);
    align-items: center;
  }
  /* Musí být až za .dvojice — stejná specificita, rozhoduje pořadí. */
  .dvojice--nastroje { grid-template-columns: 1fr 1.25fr; }
  .foto {
    width: min(100%, 400px);
    height: auto;
    justify-self: end;
    border-radius: var(--radius);
    background: var(--linen-deep);
  }

  .dvojice--foto { margin-top: 32px; align-items: start; }
  .ucinky--uzke { grid-template-columns: 1fr; margin-top: 0; }

  .ucinky {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 40px;
  }
  .ucinky li {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule-soft);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ucinky b { font-family: var(--display); font-size: 1.15rem; font-weight: 500; }
  .ucinky span { font-size: .9rem; color: var(--muted); }

  .karty {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 32px;
  }

  .poznamka {
    margin-top: 30px;
    padding-left: 16px;
    border-left: 2px solid var(--honey);
    font-size: .9rem;
    color: var(--muted);
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .dvojice, .dvojice--nastroje { grid-template-columns: 1fr; }
    .foto-nastroje { max-width: 100%; justify-self: start; }
    .foto { width: min(100%, 340px); justify-self: start; }
  }
</style>
