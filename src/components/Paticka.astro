---
import logoSvetle from '../assets/logo-svetle.png';

import kontakt from '../data/kontakt.json';
import { odkaz } from '../lib/odkaz';
const rok = new Date().getFullYear();
const site = kontakt.site;
---

<footer class="paticka">
  <div class="wrap">
    <div class="foot">
      <a class="znacka" href={odkaz('/')} aria-label={`${kontakt.nazev} — úvodní stránka`}>
        <img src={logoSvetle.src} alt={kontakt.nazev} width={logoSvetle.width} height={logoSvetle.height} />
      </a>

      <ul>
        <li><a href={odkaz('/osetreni/')}>Ošetření a ceník</a></li>
        <li><a href={odkaz('/madero-terapie/')}>Maderoterapie</a></li>
        <li><a href={odkaz('/o-mne/')}>O mně</a></li>
        <li><a href={odkaz('/kontakt/')}>Kontakt</a></li>
      </ul>

      <ul>
        <li><a href={`tel:${kontakt.telefonLink}`}>{kontakt.telefon}</a></li>
        <li><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></li>
        {site.instagram && <li><a href={site.instagram} rel="noopener">Instagram</a></li>}
        {site.facebook && <li><a href={site.facebook} rel="noopener">Facebook</a></li>}
        <li><a href={odkaz('/ochrana-udaju/')}>Ochrana osobních údajů</a></li>
      </ul>
    </div>

    <p class="pravni">
      {kontakt.provozovatel} · {kontakt.adresa.ulice}, {kontakt.adresa.psc} {kontakt.adresa.mesto} · IČO: {kontakt.ico}<br />
      Fyzická osoba zapsaná v živnostenském rejstříku.
      {!kontakt.platceDph && ' Ceny jsou konečné, nejsem plátcem DPH.'}<br />
      © {rok} {kontakt.nazev}
    </p>
  </div>
</footer>

<style>
  .paticka {
    background: var(--pine-dark);
    color: var(--on-dark);
    padding: 52px 0 34px;
    font-size: .85rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    justify-content: space-between;
    align-items: flex-start;
  }
  .foot a { text-decoration: none; border-bottom: 1px solid transparent; }
  .foot a:hover { border-bottom-color: var(--honey); }
  .foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }

  .znacka { display: block; line-height: 0; }
  .znacka img { width: auto; height: 58px; }

  .pravni {
    margin: 34px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule-dark);
    font-size: .76rem;
    line-height: 1.8;
  }
</style>
