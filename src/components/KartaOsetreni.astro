---
const { osetreni } = Astro.props;
const zvyraznene = osetreni.zvyraznit === true;
---

<article
  class:list={['karta', 'rv', { 'karta--zvyraznena': zvyraznene }]}
  data-resi={osetreni.resi.join(' ')}
>
  <p class="karta__skupina">{osetreni.skupina}</p>
  <h3>{osetreni.nazev}</h3>
  <p class="karta__popis">{osetreni.popis}</p>
  <div class="karta__udaje">
    <span class="udaj__delka">{osetreni.delka}</span>
    <span class="udaj__cena">{osetreni.cena}</span>
  </div>
</article>

<style>
  .karta {
    background: var(--shell);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    padding: 26px 26px 22px;
    display: flex;
    flex-direction: column;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease,
                opacity .6s ease;
  }
  .karta:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px var(--stin);
    border-color: var(--rule);
  }

  .karta__skupina {
    font-family: var(--mono);
    font-size: .6rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .karta h3 { margin-bottom: 10px; }
  .karta__popis { font-size: .92rem; color: var(--muted); margin-bottom: 20px; }

  .karta__udaje {
    margin-top: auto;
    border-top: 1px solid var(--rule-soft);
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .udaj__delka { font-family: var(--mono); font-size: .8rem; color: var(--muted); }
  .udaj__cena {
    font-family: var(--mono);
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--honey-text);
    white-space: nowrap;
  }

  /* Zvýrazněná varianta — používat střídmě, ideálně na jednu kartu */
  .karta--zvyraznena {
    background: var(--pine);
    color: var(--linen);
    border-color: var(--pine);
  }
  .karta--zvyraznena .karta__skupina,
  .karta--zvyraznena .karta__popis { color: var(--on-dark); }
  .karta--zvyraznena .karta__udaje { border-top-color: var(--rule-dark); }
  .karta--zvyraznena .udaj__delka { color: var(--on-dark-slaby); }
  .karta--zvyraznena .udaj__cena { color: var(--honey-soft); }

  /* Skryto filtrem */
  .karta.skryta { display: none; }
</style>
